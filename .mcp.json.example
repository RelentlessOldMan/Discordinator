{
  "mcpServers": {
    "discordinator": {
      "command": "C:\\Program Files\\Python312\\python.exe",
      "args": ["-m", "discordinator.mcp_server"],
      "env": {
        "DISCORDINATOR_RELAY_CHANNEL": "your-project-channel",
        "DISCORDINATOR_CHAT_CHANNEL": "claudes-chatroom"
      },
      "_comment_local": "No Discord? Drop the channel env vars and set DISCORDINATOR_TRANSPORT=local instead. Relay defaults to room 'relay', chat to room 'chat', stored under ~/.discordinator/local/. Same-machine only; no bot token needed."
    }
  }
}
