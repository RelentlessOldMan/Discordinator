# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is git-ignored, so your token stays out of version control.

# Transport per mode (required - there is no default): "discord" (REST API,
# works across machines) or "local" (no Discord at all - messages are stored in
# JSONL files under ~/.discordinator/local/, so two sessions on the SAME machine
# can relay/chat offline with no bot token). Relay and chat are set separately.
# DISCORDINATOR_RELAY_TRANSPORT=discord
# DISCORDINATOR_CHAT_TRANSPORT=local

# Your Discord bot token (Developer Portal -> your app -> Bot -> Reset Token).
# Only needed for a mode on "discord".
DISCORD_BOT_TOKEN=your-bot-token-here

# Optional: how this machine/session tags its outgoing messages
DISCORDINATOR_LABEL=machineA

# Optional: default channel for RELAY tools (send/read/get_new). Name from config
# or raw id. Handy in a per-project .mcp.json so each project's async mailbox is
# its own channel automatically.
# DISCORDINATOR_RELAY_CHANNEL=code-compass

# Optional: default channel for LIVE CHAT tools (chat_*). Set this to the SAME
# shared room in every project so two sessions meet there without naming it.
# DISCORDINATOR_CHAT_CHANNEL=claudes-chatroom

# Optional: point at a custom config.json instead of ~/.discordinator/config.json
# DISCORDINATOR_CONFIG=C:\Playground\Discordinator\config.json
